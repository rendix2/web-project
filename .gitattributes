# LF everywhere, in git and in the working copy (core.autocrlf=true is set globally on WSL and Windows); binaries are left alone
* text=auto eol=lf

.gitattributes  export-ignore
.github         export-ignore
.gitignore      export-ignore
.travis.yml     export-ignore
tests/          export-ignore

*.sh            eol=lf
latte-lint      text eol=lf
