<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width">
        <title>{ifset title}{include title|stripHtml}{/ifset}</title>

        {asset app.js}
    </head>

    <body>
        {var $isUsers = str_starts_with($presenter->getName(), 'Admin:User:')}
        {var $isRoles = str_starts_with($presenter->getName(), 'Admin:Role:')}
        {var $isList = str_ends_with($presenter->getName(), ':List')}

        <nav id="admin-navigation" class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link{if $isUsers} active{/if}" href="{link :Admin:User:List:default}" n:attr="aria-current => $isUsers ? 'page'">
                            <i class="fas fa-users"></i> {_admin-menu.users}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{if $isRoles} active{/if}" href="{link :Admin:Role:List:default}" n:attr="aria-current => $isRoles ? 'page'">
                            <i class="fas fa-user-tag"></i> {_admin-menu.roles}
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                {if $isUsers}
                    <li class="breadcrumb-item{if $isList} active{/if}" n:attr="aria-current => $isList ? 'page'"><a href="{link :Admin:User:List:default}">{_admin-menu.users}</a></li>
                {elseif $isRoles}
                    <li class="breadcrumb-item{if $isList} active{/if}" n:attr="aria-current => $isList ? 'page'"><a href="{link :Admin:Role:List:default}">{_admin-menu.roles}</a></li>
                {/if}
                {if !$isList}
                    {ifset title}<li class="breadcrumb-item active" aria-current="page">{include title|stripHtml}</li>{/ifset}
                {/if}
            </ol>
        </nav>

        {snippet flashes}
        <div class="container-fluid">
            {foreach $flashes as $flash}
                <div class="alert alert-{$flash->type} alert-dismissible fade show shadow-sm border-0 border-start border-4 border-{$flash->type} d-flex align-items-center py-3 mb-3" role="alert">
                    <div class="alert-icon-aside me-3 h4 mb-0 opacity-75">
                        {if $flash->type === 'success'}
                            <i class="fas fa-check-circle"></i>
                        {elseif $flash->type === 'danger'}
                            <i class="fas fa-exclamation-triangle"></i>
                        {elseif $flash->type === 'info'}
                            <i class="fas fa-info-circle"></i>
                        {elseif $flash->type === 'warning'}
                            <i class="fas fa-exclamation-circle"></i>
                        {/if}
                    </div>

                    <div>
                        {$flash->message}
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {/foreach}
        </div>
        {/snippet}

        <div class="container-fluid">
            {include content}
        </div>
    </body>
</html>
