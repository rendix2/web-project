{block title}{_admin-role-list.title}{/block}

{block content}
   <div class="card border-0 mt-1">
        <div class="card-header bg-white py-3 d-flex align-items-center">
            <h1 class="h6 m-0 fw-bold text-primary">
                <i class="fas fa-users me-2"></i>{_admin-role-list.list.header}
            </h1>
            <a href="{link :Admin:Role:Create:default}" class="btn btn-secondary ms-auto">
                <i class="fas fa-plus"></i> {_admin-role-list.add-role}
            </a>
        </div>
        <div class="card-body">
            {control grid}
        </div>
    </div>
{/block}
