{block content}
    <div class="d-flex justify-content-center mt-1">
        <div class="card col-3">
            <div class="card-header">
                <h1 class="h5 mb-0"><i class="fas fa-key"></i> {_web-user-changePassword.form.header}</h1>
            </div>
            <div class="card-body">
                {snippet changePasswordFormWrapper}
                    {control changePasswordForm}
                {/snippet}
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-center mt-1">
        <div class="card col-3">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="fas fa-history"></i> {_web-user-changePassword.password-history.header}</h2>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    {foreach $userEntity->passwords as $password}
                        <li class="list-group-item {if $iterator->isLast()}active{/if}"
                            {if $iterator->isLast()}aria-current="true"{/if}>{$password->createdAt|localDate:yMd}</li>
                    {/foreach}
                </ul>
            </div>
        </div>
    </div>
{/block}
