<html>
<head>
    <meta charset="utf-8">
    <title>Password recovery</title>
    <style>
    </style>
</head>
<body>
<p>Hello,</p>

<p>
    We received a request to reset your password. Please use this link to set a new one
    <a href="{link //:Web:User:ForgetPassword:Change:default, $userEntity->id, $userEntity->passwordRequests[0]->forgetKey}">here</a>
</p>

<p>
    If you did not request a password reset, you can safely ignore this email.
</p>
</body>
</html>
