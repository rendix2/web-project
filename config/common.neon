parameters:


application:
    debugger: true
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping:
        *: App\UI\*\**Presenter


session:
    debugger: true
    expiration: 14 days
    autoStart: smart

latte:
    debugger: true
    strictParsing: yes
    strictTypes: true
    locale: cs_CZ

di:
    debugger: true
    export:
        parameters: true
        tags: true

http:
    cookieSecure: auto
    # X-Frame-Options (older browsers; frame-ancestors below says the same)
    frames: DENY
    headers:
        X-Content-Type-Options: nosniff
        Referrer-Policy: strict-origin-when-cross-origin
        # browsers obey it only over HTTPS
        Strict-Transport-Security: 'max-age=31536000'
    csp:
        default-src: self
        # `nonce` is generated for every request, Tracy uses it for its own scripts; no inline script in the templates
        script-src: [self, nonce]
        # style="" attributes of the templates, Tom Select and Bootstrap positioning
        style-src: [self, unsafe-inline]
        img-src: [self, 'data:']
        font-src: [self, 'data:']
        object-src: none
        base-uri: self
        form-action: self
        frame-ancestors: none

security:
    debugger: true

routing:
    debugger: true
    # no compile-time cache: it evals the body of the router service at compile time, which works only for a static factory
    # call; the router is `@routerFactory::create()` of a normal service (no static methods), building 3 routes costs nothing
    cache: false

tracy:
    maxLength: 500
    maxDepth: 10
    showLocation: true
    strictMode: true
    showBar: true

assets:
    basePath: /var/www/html/www
    mapping:
        default:
            type: vite
            path: assets
        styles:
            path: css


#mail:
    #smtp: %mail.smtp%

    #host: %mail.host%
    #port: %mail.port%
    #username: %mail.username%
    #password: %mail.password%
    #timeout: ...     # (int)
    #encryption: ...  # (ssl|tls|null) výchozí je null (má alias 'secure')
    #clientHost: ...  # (string) výchozí je $_SERVER['HTTP_HOST']
    #persistent: ...  # (bool) výchozí je false

services:
    -
        create: App\Core\UsernameAndPasswordAuthenticator
        autowired: self

    -
        create: App\Core\AutoLoginAuthenticator
        autowired: self

extensions:
    chatbot: App\DI\ServicesExtension



