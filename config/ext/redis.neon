extensions:
    redis: Contributte\Redis\DI\RedisExtension

redis:
    debug: %debugMode%
    clientFactory: Predis\Client
    connection:
        default:
            uri: tcp://web-project-redis
            sessions: false
            storage: true
            options: ['parameters': ['database': 0]]
        session:
            uri: tcp://web-project-redis
            sessions:
                # = session.expiration (14 days); without it the handler takes php.ini's session.gc_maxlifetime (24 minutes)
                ttl: 1209600
            storage: false
            options: ['parameters': ['database': 1]]