search:
	-   in: %appDir%
		classes:
			- *Factory
			- *Facade
			- *Grid
			- *Service
			- *Mapper
		# the datagrid component itself (`new SecuredDatagrid()` in every grid), no shared service
		exclude:
			classes:
				- App\UI\Grid\*

services:
    RouterFactory: App\Core\RouterFactory::createRouter

includes:
    - ext/console.neon
    - ext/guzzle.neon
    - ext/nettrine.neon
    - ext/translation.neon
    - ext/mailing.neon
    - ext/redis.neon
    - ext/pwned.neon
