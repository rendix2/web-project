search:
	-   in: %appDir%
		classes:
			- *Factory
			- *Facade
			- *Grid
			- *Service

services:
    RouterFactory: App\Core\RouterFactory::createRouter

includes:
    - ext/console.neon
    - ext/guzzle.neon
    - ext/nettrine.neon
    - ext/translation.neon
    - ext/menu.neon
    - ext/mailing.neon
    - ext/redis.neon
    - ext/pwned.neon
