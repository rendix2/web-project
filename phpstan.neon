parameters:
    level: 10
    stubFiles:
        #- %rootDir%/../../../app/PHPStan/Stubs/nette-forms.php
    doctrine:
        objectManagerLoader: %rootDir%/../../../app/PHPStan/object-manager.php
        reportDynamicQueryBuilders: true
        reportUnknownTypes: true
        ormRepositoryClass: Doctrine\ORM\EntityRepository
    strictRules:
        allRules: true
    methodsThrowingExceptions:
        Nette\Application\UI\Presenter:
            redirectUrl: Nette\Application\AbortException
            sendJson: Nette\Application\AbortException
            sendResponse: Nette\Application\AbortException
            terminate: Nette\Application\AbortException
            forward: Nette\Application\AbortException
            restoreRequest: Nette\Application\AbortException

        Nette\Application\UI\Component:
            redirect: Nette\Application\AbortException
            redirectPermanent: Nette\Application\AbortException
            error: Nette\Application\BadRequestException

    excludePaths:
        # generated migrations use the deprecated Schema API of the migration base class
        - app/Database/Migrations
    paths:
        - app

    ignoreErrors:
        # BIGINT primary keys are strings on purpose (Doctrine returns bigint as string, PHP has no unsigned 64 bit int)
        -
            identifier: doctrine.columnType
            message: '#type mapping mismatch: database can contain int but property expects string#'
        # custom DBAL type (App\Database\Types\IpAddressType), PHPStan has no descriptor for it
        -
            identifier: doctrine.descriptorNotFound
            message: '#Doctrine type "ip_address"#'
