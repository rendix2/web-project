parameters:
    level: 10
    paths:
        - app
        - tests
    excludePaths:
        analyse:
            # generated by `codecept build` (make phpstan and CI run it first): read only for the actor traits ($I->...)
            - tests/Support/_generated
        analyseAndScan:
            - tests/_output (?)
            - tests/Support/_output (?)
    doctrine:
        objectManagerLoader: %rootDir%/../../../app/PHPStan/object-manager.php
        reportDynamicQueryBuilders: true
        reportUnknownTypes: true
        ormRepositoryClass: Doctrine\ORM\EntityRepository
    strictRules:
        allRules: true
    methodsThrowingExceptions:
        Nette\Application\UI\Presenter:
            redirectUrl: Nette\Application\AbortException
            sendJson: Nette\Application\AbortException
            sendResponse: Nette\Application\AbortException
            terminate: Nette\Application\AbortException
            forward: Nette\Application\AbortException
            restoreRequest: Nette\Application\AbortException

        Nette\Application\UI\Component:
            redirect: Nette\Application\AbortException
            redirectPermanent: Nette\Application\AbortException
            error: Nette\Application\BadRequestException

    ignoreErrors:
        # DBAL 4.5 deprecates the mutable Schema API (createTable, addColumn, setComment, ...), but
        # AbstractMigration::up(Schema $schema) still needs $schema changed in place and the project writes
        # migrations with the Schema API on purpose (AGENTS.md) - no non-deprecated way exists yet (same as alfred)
        -
            identifier: method.deprecated
            path: app/Database/Migrations/*

services:
    # the custom DBAL type ip_address (App\Database\Types\IpAddressType) for phpstan-doctrine
    -
        class: App\PHPStan\Doctrine\Types\IpAddressTypeDescriptor
        tags: [phpstan.doctrine.typeDescriptor]
    # $I->grabService(X::class) returns X
    -
        class: App\PHPStan\Codeception\GrabServiceReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]

rules:
    # flashMessage() gets a \stdClass, never a string (AGENTS.md "Flash messages are objects")
    - App\PHPStan\Rules\FlashMessageStdClassRule
